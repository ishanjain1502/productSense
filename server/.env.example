NEATLOGS_API_KEY=
PORT=1337
DATABASE_PATH=./data/app.db
# Comma-separated list of allowed browser origins (must match dev server URL)
# Monolith Docker / single Render service: use one origin (e.g. http://localhost:3000).
CLIENT_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002
JWT_SECRET=change-me-to-a-long-random-string
# Demo user created by npm run seed:demo (login for pre-seeded demo projects)
DEMO_USER_EMAIL=demo@productsense.app
DEMO_USER_PASSWORD=DemoProduct1!
COMMANDCODE_API_KEY=
COMMANDCODE_MODEL=deepseek/deepseek-v4-flash
# Split Docker: http://localhost:1337 — Monolith / Render: same URL as the web app.
PUBLIC_API_URL=http://localhost:1337
# 32+ char secret for encrypting per-user cfo.ai OAuth tokens at rest (use KMS in production)
CFO_TOKEN_ENCRYPTION_KEY=
CRUSTDATA_API_KEY=
CRUSTDATA_API_BASE=https://api.crustdata.com
# Required on all Crustdata OpenAPI requests (see docs.crustdata.com)
CRUSTDATA_API_VERSION=2025-11-01
# Use "token" if your key expects Authorization: Token …
CRUSTDATA_AUTH_SCHEME=bearer
MARKET_ANALYSIS_MAX_COMPETITORS=5
